{
  "functions": {
    "api/product.js": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/feeds/google.xml", "destination": "/api/feed?type=google" },
    { "source": "/feeds/prom.xml", "destination": "/api/feed?type=prom" },
    { "source": "/feeds/hotline.xml", "destination": "/api/feed?type=hotline" },
    { "source": "/p/:slug", "destination": "/api/product?slug=:slug" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
