{
  "functions": {
    "api/product.js": {
      "includeFiles": "dist/app.html"
    },
    "api/page.js": {
      "includeFiles": "dist/app.html"
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!robots\\.txt$).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(AhrefsBot|AhrefsSiteAudit|SemrushBot|SiteAuditBot|MJ12bot|DotBot|BLEXBot|DataForSeoBot|serpstatbot|Barkrowler).*"
        }
      ],
      "destination": "/api/blocked"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/api/sitemap?part=pages"
    },
    {
      "source": "/sitemap-products-:n.xml",
      "destination": "/api/sitemap?part=products&n=:n"
    },
    {
      "source": "/feeds/google-partners.xml.gz",
      "destination": "/api/feed?type=google-partners"
    },
    {
      "source": "/feeds/google.xml",
      "destination": "/api/feed?type=google"
    },
    {
      "source": "/feeds/prom.xml",
      "destination": "/api/feed?type=prom"
    },
    {
      "source": "/feeds/hotline.xml",
      "destination": "/api/feed?type=hotline"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/product?slug=:slug"
    },
    {
      "source": "/",
      "destination": "/api/page?path=/"
    },
    {
      "source": "/katalog/:slug",
      "destination": "/api/page?path=/katalog/:slug"
    },
    {
      "source": "/statti",
      "destination": "/api/page?path=/statti"
    },
    {
      "source": "/statti/:slug",
      "destination": "/api/page?path=/statti/:slug"
    },
    {
      "source": "/:info(dostavka-i-oplata|garantiya-i-povernennya|pro-nas|kontakty|faq)",
      "destination": "/api/page?path=/:info"
    },
    {
      "source": "/:city(avtozapchastyny-synelnykove|avtozapchastyny-dnipro|avtozapchastyny-pavlohrad|avtozapchastyny-samar|avtozapchastyny-vasylkivka|avtozapchastyny-mezhova)",
      "destination": "/api/page?path=/:city"
    },
    {
      "source": "/forum",
      "destination": "/api/page?path=/forum"
    },
    {
      "source": "/forum/:topic",
      "destination": "/api/page?path=/forum/:topic"
    },
    {
      "source": "/:legal(oferta|privacy)",
      "destination": "/api/page?path=/:legal"
    },
    {
      "source": "/:app(admin|account|oplata)",
      "destination": "/app.html"
    },
    {
      "source": "/:from((?!api/|assets/).*)",
      "destination": "/api/page?path=/404&from=/:from"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "c",
          "value": "(?<c>[a-z0-9-]+)"
        }
      ],
      "destination": "/katalog/:c",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://zzxueclhkhvwdmxflmyx.supabase.co wss://zzxueclhkhvwdmxflmyx.supabase.co https://api.novaposhta.ua https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.facebook.com https://connect.facebook.net https://stats.g.doubleclick.net https://www.google.com https://wsrv.nl; frame-src https://www.google.com https://maps.google.com https://*.facebook.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
